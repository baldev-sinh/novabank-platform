# Copy to .env (git-ignored) and fill in real values. Never commit .env.
# Used by compose.yaml and the services' "local" Spring profile.
# Keep values free of backslashes: Spring reads this file as .properties.

# Auth service database (compose service "auth-db")
AUTH_DB_USERNAME=novabank_auth
AUTH_DB_PASSWORD=change-me
AUTH_DB_PORT=5433

# Customer service database (compose service "customer-db")
CUSTOMER_DB_USERNAME=novabank_customer
CUSTOMER_DB_PASSWORD=change-me
CUSTOMER_DB_PORT=5434

# Account service database (compose service "account-db")
ACCOUNT_DB_USERNAME=novabank_account
ACCOUNT_DB_PASSWORD=change-me
ACCOUNT_DB_PORT=5435

# Ledger service database (compose service "ledger-db")
LEDGER_DB_USERNAME=novabank_ledger
LEDGER_DB_PASSWORD=change-me
LEDGER_DB_PORT=5436

# Payment service database (compose service "payment-db")
PAYMENT_DB_USERNAME=novabank_payment
PAYMENT_DB_PASSWORD=change-me
PAYMENT_DB_PORT=5437

# Audit service (7.4)
AUDIT_DB_USERNAME=novabank_audit
AUDIT_DB_PASSWORD=change-me
AUDIT_DB_PORT=5438
# HMAC key of the audit chain: base64, at least 32 bytes. Generate one: openssl rand -base64 32
# Changing it later makes every existing audit entry fail verification.
AUDIT_CHAIN_KEY=change-me

# Notification service (7.6)
NOTIFICATION_DB_USERNAME=novabank_notification
NOTIFICATION_DB_PASSWORD=change-me
NOTIFICATION_DB_PORT=5439

# Grafana (7.7), http://localhost:3000, user admin. Required by compose; no default.
GRAFANA_ADMIN_PASSWORD=change-me

# JWT signing keys (RS256). Optional locally: the "local" profile generates a throwaway key pair.
# To keep tokens valid across restarts, generate a pair and point at the files:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out jwt-private.pem
#   openssl pkey -in jwt-private.pem -pubout -out jwt-public.pem
# AUTH_JWT_PRIVATE_KEY_LOCATION=file:/absolute/path/jwt-private.pem
# AUTH_JWT_PUBLIC_KEY_LOCATION=file:/absolute/path/jwt-public.pem

# Browser origins allowed to call auth (comma-separated). The "local" profile allows
# http://localhost:4200; every other environment must set it, or no cross-origin call is allowed.
# CORS_ALLOWED_ORIGINS=https://app.novabank.example

# First administrator: this address becomes ADMIN once its email is verified (or at startup if it
# already is). Defaults to admin@novabank.local in the "local" profile and compose; unset it in a
# real environment once the first admin exists.
# BOOTSTRAP_ADMIN_EMAIL=admin@novabank.example
