# Copy to .env (git-ignored) and fill in real values. Never commit .env.
# Used by compose.yaml and the services' "local" Spring profile.
# Keep values free of backslashes: Spring reads this file as .properties.

# Auth service database (compose service "auth-db")
AUTH_DB_USERNAME=novabank_auth
AUTH_DB_PASSWORD=change-me
AUTH_DB_PORT=5433

# Customer service database (compose service "customer-db")
CUSTOMER_DB_USERNAME=novabank_customer
CUSTOMER_DB_PASSWORD=change-me
CUSTOMER_DB_PORT=5434

# JWT signing keys (RS256). Optional locally: the "local" profile generates a throwaway key pair.
# To keep tokens valid across restarts, generate a pair and point at the files:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out jwt-private.pem
#   openssl pkey -in jwt-private.pem -pubout -out jwt-public.pem
# AUTH_JWT_PRIVATE_KEY_LOCATION=file:/absolute/path/jwt-private.pem
# AUTH_JWT_PUBLIC_KEY_LOCATION=file:/absolute/path/jwt-public.pem
